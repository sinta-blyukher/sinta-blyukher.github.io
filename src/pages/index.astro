---
import BaseLayout from "../layouts/Default.astro";
//window.alert("Loaded");
---

<BaseLayout>
  <main class="mx-auto max-w-4xl p-6 md:p-10 space-y-8">
    <!-- Profile -->
    <section
      aria-labelledby="about-title"
      class="neu-card neu--radius-lg p-6 md:p-8"
      id="about"
    >
      <h1
        id="about-title"
        class="text-3xl md:text-4xl font-semibold mb-6 typewriter"
      >
        About Me
      </h1>
      <div class="grid md:grid-cols-3 gap-6 items-center">
        <div class="flex justify-center md:justify-start">
          <img
            src="../icon6.png"
            alt="プロフィール"
            class="h-28 w-28 md:h-32 md:w-32 rounded-full ring-2 ring-cyan-300 object-cover"
          />
        </div>
        <div class="md:col-span-2 space-y-2">
          <p class="text-lg leading-relaxed">
            <span class="font-medium">Sugimoto</span>
            です。大学生1年生です。低レイヤーとかに興味があります。
          </p>
          <p class="text-gray-600">所属: Future University Hakodate</p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-4">
        <a href="/blog/" class="neu-card neu--sm px-5 py-2 neu-pressable">
          Blog
        </a>
        <a
          href="https://x.com/sug1m0t0_unk"
          class="neu-card neu--sm px-5 py-2 neu-pressable"
        >
          Xアカウント
        </a>
      </div>
    </section>

    <!-- Timeline -->
    <section
      aria-labelledby="timeline-title"
      class="neu-card neu--radius-lg p-6 md:p-8"
    >
      <h2 id="timeline-title" class="text-2xl font-semibold mb-4 typewriter">
        Timeline
      </h2>
      <ol class="relative border-s border-gray-300 ps-5 space-y-5">
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2025-12</time>
          <p class="font-medium">P2Hacks Cyber Agent賞受賞</p>
        </li>
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2025-08</time>
          <p class="font-medium">留年確定</p>
        </li>
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2025-04</time>
          <p class="font-medium">公立はこだて未来大学入学</p>
        </li>
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2024</time>
          <p class="font-medium">浪人</p>
        </li>
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2021</time>
          <p class="font-medium">中学校卒業</p>
        </li>
        <li>
          <div
            class="absolute -start-1.5 translate-x-0 w-3 h-3 rounded-full bg-cyan-500"
          >
          </div>
          <time class="text-sm text-gray-500">2019</time>
          <p class="font-medium">プログラミングに初めて触れる</p>
        </li>
      </ol>
    </section>

    <section class="neu-card neu--radius-lg p-6 md:p-8 text-left space-y-4">
      <h2 class="text-2xl md:text-3xl font-semibold typewriter">
        What&apos;s here
      </h2>
      <ul class="list-disc list-inside space-y-2 text-sm md:text-base">
        <li>
          <span class="font-medium">Blog</span>：
          勉強メモ、技術的な試行錯誤、思想的なメモなど
        </li>
        <li>
          <span class="font-medium">About</span>：
          自己紹介・タイムライン・スキルの簡単な一覧
        </li>
        <li>
          <span class="font-medium">Works</span>： 作ったもの
        </li>
      </ul>
    </section>

    <main class="p-6 space-y-8 max-w-5xl mx-auto">
      <!-- Skills -->
      <section
        aria-labelledby="skills-title"
        class="neu-card neu--radius-lg p-6 md:p-8"
        id="skills-studies"
      >
        <h2 id="skills-title" class="text-2xl font-semibold mb-4 typewriter">
          Skills(勉強中)
        </h2>
        <ul class="flex flex-wrap gap-2">
          <li>
            <span class="terminal-chip text-sm">Tailwind CSS</span>
          </li>
          <li>
            <span class="terminal-chip text-sm">HTML</span>
          </li>
          <li>
            <span class="terminal-chip text-sm">JavaScript(勉強中)</span>
          </li>
          <li>
            <span class="terminal-chip text-sm">Processing</span>
          </li>
          <li>
            <span class="terminal-chip text-sm">C言語(勉強中)</span>
          </li>
          <li>
            <span class="terminal-chip text-sm">Docker(勉強中)</span>
          </li>
          <li>
            <span class="terminal-chip text-sm"> Ruby </span>
          </li>
          <li>
            <span class="terminal-chip text-sm"> Zig(勉強中) </span>
          </li>
        </ul>
      </section>

      <section class="py-10 grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="space-y-6 profile-text">
          <h2 class="text-3xl font-semibold text-pink-400 typewriter">
            使ってるデバイス
          </h2>
          <ul class="list-disc list-inside text-gray-300">
            <li>ThinkPad T14 amd gen5</li>
            <li>Let's Note cf-lv6</li>
            <li>自作PC CPU:Ryzen 9 3900x</li>
            <li>ThinkPad X220</li>
          </ul>
        </div>
        <div class="space-y-6 profile-text">
          <h2 class="text-3xl font-semibold text-pink-400 typewriter">
            使ったことのあるデバイス
          </h2>
          <ul class="list-disc list-inside text-gray-300">
            <li>自作PC CPU:core i5 4th</li>
            <li>Lavie pm(x)</li>
            <li>Pixel 8a</li>
            <li>Pixel 6a</li>
          </ul>
        </div>
      </section>
      <header id="works" class="space-y-2">
        <h1 class="text-3xl md:text-4xl font-semibold typewriter">
          成果物一覧
        </h1>
        <p class="text-sm md:text-base text-gray-500">
          自分で作ったもののうち、ある程度形になっているものだけをまとめています。
        </p>
      </header>

      <section aria-labelledby="works-heading">
        <h2
          id="works-heading"
          class="sr-only"
          style="position:absolute;left:-9999px;"
        >
          作品一覧
        </h2>

        <ul class="grid gap-6 md:grid-cols-2">
          <li class="neu-card neu--radius-lg p-6 space-y-3">
            <div class="space-y-1">
              <h3 class="text-lg font-semibold">アジプロジェネレーター</h3>
              <p class="text-sm text-gray-400">
                プロンプトを入力すると、ソ連風の
                アジテーション・プロパガンダ文を生成する
                ジェネレーター（デプロイはまだ）。
              </p>
            </div>

            <div class="flex flex-wrap gap-2 text-xs mt-2">
              <span class="terminal-chip">FastAPI</span>
              <span class="terminal-chip">Python</span>
            </div>

            <div class="mt-3 flex items-center gap-3 text-sm">
              <a
                href="https://github.com/sugimoto-blyukher/ajipuro"
                target="_blank"
                rel="noopener"
                class="nav-link"
              >
                GitHub
              </a>
              <a
                href="https://ajipuro.sinta.site"
                target="_blank"
                rel="noopener"
                class="nav-link"
              >
                リンク
              </a>
              <time datetime="2025-11" class="ml-auto text-xs text-gray-500"
                >2025-11</time
              >
            </div>
          </li>
        </ul>
      </section>

      <!-- Contact -->
      <section
        aria-labelledby="contact-title"
        class="neu-card neu--radius-lg p-6 md:p-8 neu-pressable"
      >
        <h2 id="contact-title" class="text-2xl font-semibold mb-4 typewriter">
          Contact
        </h2>
        <div class="flex flex-wrap gap-3">
          <a
            class="neu-card neu--sm px-4 py-2 neu-ring"
            href="mailto:ramenrice555@gmail.com">Email</a
          >
          <a
            class="neu-card neu--sm px-4 py-2 neu-ring"
            href="/page/articles.html">Articles</a
          >
        </div>
      </section>
    </main>
  </main>
</BaseLayout>
